{
  // Must match the Worker's name in the Cloudflare dashboard
  "name": "alexanderk-dev",
  "compatibility_date": "2026-10-20",
  "assets": {
    // Serve the repo root as a static site
    "directory": "./",
    // Every path (like /projects/switch-to-youtube) loads index.html;
    // the terminal reads the address and opens in that directory
    "not_found_handling": "single-page-application"
  }
}

# How long browsers may keep each kind of file (Cloudflare reads this file for
# the site's static files). Pages, the scripts in js/ and the data files keep
# Cloudflare's default (checked again on every visit), so a new deploy shows
# up straight away.

# Astro's bundles, the shared stylesheet among them, have a hash of their
# contents in their names: a changed file gets a new name, so these never need
# checking again
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and photos rarely change: kept a week (fonts) or a day (photos), and
# after that shown from the cache while the browser checks for a newer copy
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

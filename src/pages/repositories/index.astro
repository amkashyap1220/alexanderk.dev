---
// The Repositories page (at /repositories/), laid out like the Research page:
// Featured, then More repositories.
// The tiers come from src/data/projects.ts (each project's `tier`). Featured
// projects get a picture; under More work, the "more" tier gets a line and a
// status each, then the archive tier a list with dotted leaders. The layout
// is in src/styles/work.css.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tech from "../../components/Tech.astro";
import { pics } from "../../lib/pic";
import { projects, project, years } from "../../data/projects";
import "../../styles/editorial.css";
import "../../styles/work.css";

const count = projects.length;
const first = projects.map((p) => p.when.start.slice(0, 4)).sort()[0];
const more = projects.filter((p) => p.tier === "more");
const archive = projects.filter((p) => p.tier === "archive");
const tm = project("open-tradesman");
const sc = project("scoundrel");
const site = project("alexanderk-dev");
// A research project's main page is its write-up (which links to how it was built)
const href = (p: (typeof projects)[number]) => p.kind === "Research" && p.writeup ? p.writeup.href : `/repositories/${p.slug}`;
---
<BaseLayout
  title="Repositories · Alexander Kashyap"
  description="Projects by Alexander Kashyap: a voice-to-invoice app for the PayPal AI Hackathon, the Scoundrel card game, this site, and more, newest first."
  path="/repositories/"
  current="projects"
>
<div class="gutter ed-page">
<div class="shell">
  <header class="page-head">
    <p class="kicker"><span class="k">Repositories</span> <span>{count} projects</span> <span>{first}&ndash;now</span></p>
    <h1 class="page-hed">Things I&rsquo;ve built</h1>
    <p class="page-dek">Apps, research and coursework, newest first. The three at the top are the ones I&rsquo;d show you first.</p>
  </header>

  <section class="h-section" aria-labelledby="feat-h">
    <div class="section-head">
      <h2 id="feat-h" class="h-label">Featured repositories</h2>
    </div>

    <article class="feat" aria-labelledby="tm-h">
      <div class="feat-text">
        <p class="kicker"><span class="k">{tm.name}</span> <span>PayPal AI Hackathon</span> <span>Nov 2026</span> <span>{tm.status}</span></p>
        <h3 id="tm-h" class="hed feat-hed"><a href={`/repositories/${tm.slug}`}>{tm.headline}</a></h3>
        <p class="q">{tm.question}</p>
        <p class="h-text">A voice-first estimating app for tradespeople. Claude turns a spoken job description into an itemized, priced estimate, and PayPal invoicing handles the money. The AI does the tedious part; prices and payments never depend on it.</p>
        <p class="stack">{tm.chips.map((c, i) => <>{i > 0 && " "}<Tech name={c} /></>)}</p>
        <p class="feat-links"><a class="h-more" href={`/repositories/${tm.slug}`}>How it works</a></p>
      </div>
      <figure class="pic feat-fig">
        <img {...pics("open-tradesman")} sizes="(min-width: 1024px) 742px, (min-width: 720px) calc(100vw - 64px), calc(100vw - 32px)" width="1200" height="630" decoding="async" alt="Three phone screens from the app: the price list in Settings, the home screen with a yellow microphone button, and a $525 estimate for painting a room's walls and ceiling, all in Spanish">
        <figcaption>The price list, the home screen and an estimate, here in Spanish. The big yellow button is the microphone.</figcaption>
      </figure>
    </article>

    <article class="feat" aria-labelledby="sc-h">
      <div class="feat-text">
        <p class="kicker"><span class="k">{sc.name}</span> <span>{sc.kind}</span> <span>{years(sc.when)}</span> <span>{sc.status}</span></p>
        <h3 id="sc-h" class="hed feat-hed"><a href={sc.writeup!.href}>{sc.headline}</a></h3>
        <p class="q">{sc.question}</p>
        <p class="h-text">The solo card game Scoundrel, built for phones and computers. A small Cloudflare server deals every game and keeps the high scores, and it replays each finished game with the same rules code before it saves a score, so a score can&rsquo;t be made up.</p>
        <p class="stack">{sc.chips.map((c, i) => <>{i > 0 && " "}<Tech name={c} /></>)}</p>
        <p class="feat-links"><a class="h-more" href={sc.writeup!.href}>Play it</a> <a class="h-more" href={`/repositories/${sc.slug}`}>How I built it</a></p>
      </div>
      <figure class="pic feat-fig">
        <img {...pics("scoundrel")} sizes="(min-width: 1024px) 742px, (min-width: 720px) calc(100vw - 64px), calc(100vw - 32px)" width="1200" height="630" loading="lazy" decoding="async" alt="The game on a computer screen: a health bar at 12 of 20 over a room of four storybook-style cards: a bearded King of spades holding a sword, the 7 of diamonds, a Queen of clubs drawn as a sorceress with a staff, and the 5 of hearts">
        <figcaption>A room of four cards: two monsters, a weapon and a potion.</figcaption>
      </figure>
    </article>

    <article class="feat" aria-labelledby="site-h">
      <div class="feat-text">
        <p class="kicker"><span class="k">{site.name}</span> <span>{site.kind}</span> <span>{years(site.when)}</span> <span>{site.status}</span></p>
        <h3 id="site-h" class="hed feat-hed"><a href={`/repositories/${site.slug}`}>{site.headline}</a></h3>
        <p class="q">{site.question}</p>
        <p class="h-text">The page you&rsquo;re reading: plain HTML built with Astro, a small Cloudflare script that keeps the GitHub numbers fresh, and tests that build the site and check every page and link before it ships.</p>
        <p class="stack">{site.chips.map((c, i) => <>{i > 0 && " "}<Tech name={c} /></>)}</p>
        <p class="feat-links"><a class="h-more" href={`/repositories/${site.slug}`}>How it&rsquo;s built</a></p>
      </div>
      <figure class="pic feat-fig">
        <img {...pics("alexanderk-dev")} sizes="(min-width: 1024px) 742px, (min-width: 720px) calc(100vw - 64px), calc(100vw - 32px)" width="1200" height="630" loading="lazy" decoding="async" alt="The top of this site's homepage: the name Alexander Kashyap, a short intro and three featured project cards, under a dimmed photo of a sunset">
        <figcaption>The homepage, under a sunset over Lisle, Illinois.</figcaption>
      </figure>
    </article>
  </section>

  <section class="h-section" aria-labelledby="more-h">
    <div class="section-head">
      <h2 id="more-h" class="h-label">More repositories</h2>
    </div>
    <ul class="more">
      {more.map((p) => (
        <li>
          <h3 class="more-name"><a href={href(p)}>{p.name}</a></h3>
          <p class="more-line">{p.tagline}</p>
          <p class="more-meta mono"><span>{p.kind}</span> <span>{p.status}</span> <span>{years(p.when)}</span></p>
        </li>
      ))}
    </ul>

    <div class="archive">
      <h3 class="more-sublabel">Coursework, games and early projects</h3>
      <ol>
        {archive.map((p) => (
          <li><a href={`/repositories/${p.slug}`}><span class="t"><span class="nm">{p.name}</span><span class="tg">{p.tagline}</span></span> <span class="dots"></span> <span class="yr">{years(p.when)}</span></a></li>
        ))}
      </ol>
    </div>
  </section>
</div>
</div>
</BaseLayout>

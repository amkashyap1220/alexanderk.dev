---
// The homepage: a front page. The masthead and nav come from BaseLayout
// (home); the layout is in src/styles/home.css. The archive list, project
// count and research dates come from src/data/.
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { post, formatDate } from "../data/research";
import "../styles/home.css";

const email = "alexander.kashyap@gmail.com";
const count = projects.length;
const hv = post("chicago-home-value");
const pa = post("pa-job-market");

// Everything not featured above it, in the Projects page's order
const featured = ["bowling-ball-finder", "pa-job-market", "home-value-score", "switch-to-youtube", "alexanderk-dev"];
const archive = projects.filter((p) => !featured.includes(p.slug));
// "2021", "2020–21", "2023–now"
const years = ({ start, end }: { start: string; end?: string }) => {
  const from = start.slice(0, 4);
  if (end === "present") return `${from}–now`;
  const to = end?.slice(0, 4);
  return !to || to === from ? from : `${from}–${to.slice(2)}`;
};
---
<BaseLayout
  title="Alexander Kashyap"
  description="Alexander Kashyap, a software developer in the Chicago area. I build software, dig into data, and share what I learn."
  ogDescription="Software developer in the Chicago area. I build software, dig into data, and share what I learn."
  path="/"
  current="about"
  home
>
<div class="gutter home">
<div class="shell">
  <div class="front">
    <div class="rail">
      <section class="brief" aria-labelledby="brief-h">
        <h2 id="brief-h" class="h-label">In brief</h2>
        <div class="byline">
          <img src="/img/linkedin-photo.jpg" width="192" height="192" alt="Alex Kashyap, smiling, in glasses" decoding="async">
          <p><strong>B.S. Computer Science, NIU</strong> <span class="bl-role">Application Developer, <span class="nw">K-Rise Systems</span></span> <span class="bl-aws">AWS Certified Cloud Practitioner</span></p>
        </div>
        <div class="h-intro">
          <p>By day I write C#/.NET and SQL at <span class="nw">K-Rise</span> Systems for an <span class="nw">accounts-payable</span> automation product on JD&nbsp;Edwards. On my own time I chase questions through public data, like <a href="/research/chicago-home-value">which Chicago-area zip codes sell for less than they should</a>, and build free tools like <a href="/projects/switch-to-youtube">Switch To YouTube</a>.</p>
          <p>I learn fastest by building, and I like building with people. Right now that means <a href="https://github.com/amkashyap1220/Open-Tradesman">a <span class="nw">voice-to-invoice</span> app for the PayPal AI Hackathon</a>.</p>
          <p>Most of what I make is free and open: tools that help someone learn a thing or make a decision.</p>
        </div>
      </section>


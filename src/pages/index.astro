---
// The homepage: a brief front door. The name and tagline, a two-line intro,
// three featured cards (a picture, a title and one line each), a short More
// list and how to reach me.
// The details live on the Repositories, Lab and About pages. The layout is in
// src/styles/home.css.
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { person, site } from "../data/person";
import { pics } from "../lib/pic";
import "../styles/editorial.css";
import "../styles/home.css";

const email = "alexander.kashyap@gmail.com";
const count = projects.length;

// Each picture comes in two widths: public/img/home/<img>.webp (1200 px) and <img>-640.webp
const featured = [
  {
    kicker: ["App", "In progress"], title: "Open Tradesman", href: "/repositories/open-tradesman", img: "open-tradesman",
    line: "Talk through a job in your language, and the customer gets a priced estimate in theirs.",
    alt: "Three phone screens from the Open Tradesman app: a price list, the home screen with a yellow microphone button, and a $525 estimate",
  },
  {
    kicker: ["Research", "Published"], title: "Where is the best value in Chicagoland?", href: "/lab/chicago-home-value", img: "chicago-home-value",
    line: "Every Chicago-area zip code, scored on what matters to you, on one map.",
    alt: "Map of Chicago-area zip codes colored from red (low score) to green (high score), with the 20 best-value zips outlined in blue",
  },
  {
    kicker: ["This site", "Live"], title: "alexanderk.dev", href: "/repositories/alexanderk-dev", img: "alexanderk-dev",
    line: "A static site that keeps its own numbers fresh and checks every page before it ships.",
    alt: "The top of this site's homepage: the name Alexander Kashyap, a short intro and three featured project cards, over a dimmed photo of Hubble's Ultra Deep Field",
  },
];

// More: the projects the Repositories page lists under More repositories. A research project links to its write-up.
const more = projects.filter((p) => p.tier === "more").map((p) => ({ name: p.name, line: p.tagline, href: p.writeup?.href ?? `/repositories/${p.slug}` }));
---
<BaseLayout
  title="Alexander Kashyap"
  description="Alexander Kashyap, a software developer in the Chicago area. I build software, dig into data, and share what I learn."
  ogDescription="Software developer in the Chicago area. I build software, dig into data, and share what I learn."
  path="/"
  schema={{ "@graph": [{ "@type": "WebSite", "@id": `${site}/#site`, url: `${site}/`, name: "Alexander Kashyap", author: { "@id": person["@id"] } }, person] }}
>
<div class="gutter home">
<div class="shell">
  <header class="hello">
    <p class="kicker"><span class="k">Software developer</span> <span>Chicago area</span></p>
    <h1 class="page-hed">Alexander Kashyap</h1>
    <p class="hello-tag">I build software, dig into data, and share what I learn.</p>
    <p class="hello-lede">By day I write C#/.NET and SQL at <span class="nw">K-Rise</span> Systems, on an <span class="nw">accounts-payable</span> automation product. On my own time I build free tools and chase questions through public data.</p>
    <a class="h-more" href="/about">More about me</a>
  </header>

  <section class="h-section" aria-labelledby="feat-h">
    <div class="section-head">
      <h2 id="feat-h" class="h-label">Featured</h2>
      <a href="/repositories/">All repositories</a>
    </div>
    <ul class="fcards">
      {featured.map((f, i) => (
        <li class="fcard">
          <a class="fcard-pic" href={f.href} tabindex="-1" aria-hidden="true">
            <img {...pics(f.img)} sizes="(min-width: 1180px) 420px, (min-width: 720px) 31vw, calc(100vw - 32px)" width="1200" height="630" loading={i > 0 ? "lazy" : undefined} decoding="async" alt={f.alt}>
          </a>
          <p class="kicker">{f.kicker.map((k, i) => <>{i > 0 && " "}<span class={i === 0 ? "k" : undefined}>{k}</span></>)}</p>
          <h3 class="hed fcard-t"><a href={f.href}>{f.title}</a></h3>
          <p class="fcard-line">{f.line}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="h-section" aria-labelledby="more-h">
    <div class="section-head">
      <h2 id="more-h" class="h-label">More</h2>
      <a href="/repositories/">All {count} projects</a>
    </div>
    <ul class="brief">
      {more.map((m) => (
        <li><a href={m.href}><span class="brief-name">{m.name}</span> <span class="brief-line">{m.line}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="h-section write" id="contact" aria-labelledby="write-h">
    <div class="section-head">
      <p class="h-label">Contact</p>
    </div>
    <div class="write-inner">
      <h2 id="write-h" class="h-big">Write to me</h2>
      <p class="lede">If you&rsquo;re hiring, have a dataset you think I&rsquo;d enjoy, or want to talk through something you&rsquo;re building, email is the best way to reach me.</p>
      <div class="mailline">
        <a class="big-email" id="big-email" href={`mailto:${email}`}>{email}</a>
        <button class="copy" id="copy-email" type="button" hidden>Copy</button>
        <span id="copy-status" class="vh" aria-live="polite"></span>
      </div>
      <div class="reach">
        <a class="cta cta-solid" href="/resume.pdf">Resume <span class="mono">PDF</span></a>
        <a href="https://www.linkedin.com/in/alexander-kashyap/">LinkedIn</a>
        <a href="https://github.com/amkashyap1220">GitHub</a>
      </div>
    </div>
  </section>
</div>
</div>

  <Fragment slot="scripts">
    {/* The Copy button next to the email address. Without scripts it stays hidden and the address is a mailto link. */}
    <script is:inline>
      (function () {
        var cbtn = document.getElementById("copy-email");
        var addr = document.getElementById("big-email");
        var live = document.getElementById("copy-status");
        if (!cbtn || !addr || !live) return;
        cbtn.hidden = false;
        var timer, speak;
        function say(label, msg) {
          cbtn.textContent = label;
          clearTimeout(timer); clearTimeout(speak);
          live.textContent = "";
          speak = setTimeout(function () { live.textContent = msg; }, 60);
          timer = setTimeout(function () { cbtn.textContent = "Copy"; live.textContent = ""; }, 2500);
        }
        // Clipboard blocked or missing: select the address so it's one keystroke away
        function selectIt() {
          var r = document.createRange(); r.selectNodeContents(addr);
          var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
          say("Selected", "Email address selected.");
        }
        cbtn.addEventListener("click", function () {
          var text = addr.textContent.trim();
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).then(function () { say("Copied", "Email address copied."); }, selectIt);
            } else { selectIt(); }
          } catch (e) { selectIt(); }
        });
      })();
    </script>
  </Fragment>
</BaseLayout>

  <Fragment slot="scripts">
    {/* The Copy button next to the email address. Without scripts it stays hidden and the address is a mailto link. */}
    <script is:inline>
      (function () {
        var cbtn = document.getElementById("copy-email");
        var addr = document.getElementById("big-email");
        var live = document.getElementById("copy-status");
        if (!cbtn || !addr || !live) return;
        cbtn.hidden = false;
        var timer, speak;
        function say(label, msg) {
          cbtn.textContent = label;
          clearTimeout(timer); clearTimeout(speak);
          live.textContent = "";
          speak = setTimeout(function () { live.textContent = msg; }, 60);
          timer = setTimeout(function () { cbtn.textContent = "Copy"; live.textContent = ""; }, 2500);
        }
        // Clipboard blocked or missing: select the address so it's one keystroke away
        function selectIt() {
          var r = document.createRange(); r.selectNodeContents(addr);
          var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
          say("Selected", "Email address selected.");
        }
        cbtn.addEventListener("click", function () {
          var text = addr.textContent.trim();
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).then(function () { say("Copied", "Email address copied."); }, selectIt);
            } else { selectIt(); }
          } catch (e) { selectIt(); }
        });
      })();
    </script>
  </Fragment>
</BaseLayout>

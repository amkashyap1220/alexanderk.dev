---
// The Research page: the featured piece (`featured` in src/data/research.ts)
// gets a figure, the rest a row each. Evergreen pieces, not a dated feed.
// The layout is in src/styles/research.css, with the featured layout from work.css.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tech from "../../components/Tech.astro";
import { posts } from "../../data/research";
import { projects } from "../../data/projects";
import "../../styles/editorial.css";
import "../../styles/work.css";
import "../../styles/research.css";

const lead = posts.find((p) => p.featured) ?? posts[0];
const rest = posts.filter((p) => p !== lead);
const month = (date: string) => new Date(date + "T12:00:00Z").toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
// The project page that tells how each one was built
const built = (slug: string) => projects.find((x) => x.writeup?.href === `/research/${slug}`);
// Each preview comes in two widths: public/img/home/<slug>.webp (1200 px) and <slug>-640.webp
const thumb = (slug: string) => `/img/home/${slug}.webp`;
const thumbs = (slug: string) => `/img/home/${slug}-640.webp 640w, /img/home/${slug}.webp 1200w`;
const leadBuilt = built(lead.slug);
---
<BaseLayout
  title="Research · Alexander Kashyap"
  description="Research by Alexander Kashyap: questions answered with public data, each with interactive charts and the data and code behind them."
  path="/research/"
  current="research"
>
<div class="gutter ed-page">
<div class="shell">
  <header class="page-head">
    <p class="kicker"><span class="k">Research</span> <span>{posts.length} published</span></p>
    <h1 class="page-hed">Questions I chase through public data</h1>
    <p class="page-dek">Each one is an interactive map or set of charts you can explore, with the data and code behind it.</p>
  </header>

  <section class="h-section" aria-labelledby="lead-h">
    <div class="section-head">
      <h2 id="lead-h" class="h-label">Featured research</h2>
    </div>
    <article class="feat" aria-labelledby="lead-t">
      <div class="feat-text">
        <p class="kicker"><span class="k">{lead.chips[0]}</span> <span>{month(lead.date)}</span> <span>Data through {lead.through}</span></p>
        <h3 id="lead-t" class="hed feat-hed"><a href={`/research/${lead.slug}`}>{lead.title}</a></h3>
        <p class="h-text">{lead.lead}</p>
        <p class="stack">{lead.chips.slice(1).map((c, i) => <>{i > 0 && " "}<Tech name={c} /></>)}</p>
        <p class="feat-links">
          <a class="h-more" href={`/research/${lead.slug}`}>{leadBuilt?.writeup?.label ?? "Read it"}</a>
          {leadBuilt && <a class="h-more" href={`/projects/${leadBuilt.slug}`}>How I built it</a>}
          {lead.link && <a class="h-more" href={lead.link.href}>{lead.link.label}</a>}
        </p>
      </div>
      {lead.image && (
        <figure class="pic feat-fig">
          <img src={thumb(lead.slug)} srcset={thumbs(lead.slug)} sizes="(min-width: 1024px) 742px, (min-width: 720px) calc(100vw - 64px), calc(100vw - 32px)" width="1200" height="630" decoding="async" alt={lead.image.alt}>
        </figure>
      )}
    </article>
  </section>

  {rest.length > 0 && (
    <section class="h-section" aria-labelledby="more-h">
      <div class="section-head">
        <h2 id="more-h" class="h-label">More research</h2>
      </div>
      <ul class="inv-list">
        {rest.map((p) => {
          const b = built(p.slug);
          return (
            <li class="inv">
              {p.image && <div class="inv-thumb"><img src={thumb(p.slug)} srcset={thumbs(p.slug)} sizes="(min-width: 720px) 390px, calc(100vw - 32px)" width="1200" height="630" loading="lazy" decoding="async" alt={p.image.alt}></div>}
              <div>
                <p class="kicker"><span class="k">{p.chips[0]}</span> <span>{month(p.date)}</span> <span>Data through {p.through}</span></p>
                <h3 class="inv-name"><a href={`/research/${p.slug}`}>{p.title}</a></h3>
                <p class="inv-line">{p.summary}</p>
                <p class="feat-links">
                  <a class="h-more" href={`/research/${p.slug}`}>{b?.writeup?.label ?? "Read it"}</a>
                  {b && <a class="h-more" href={`/projects/${b.slug}`}>How I built it</a>}
                  {p.link && <a class="h-more" href={p.link.href}>{p.link.label}</a>}
                </p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</div>
</div>
</BaseLayout>

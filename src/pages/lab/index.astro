---
// The Research page: the featured piece (`featured` in src/data/research.ts)
// gets a figure, the rest a row each. Evergreen pieces, not a dated feed.
// The layout is in src/styles/research.css, with the featured layout from work.css.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tech from "../../components/Tech.astro";
import { posts } from "../../data/research";
import { projects } from "../../data/projects";
import { pics } from "../../lib/pic";
import "../../styles/editorial.css";
import "../../styles/work.css";
import "../../styles/research.css";

const lead = posts.find((p) => p.featured) ?? posts[0];
const rest = posts.filter((p) => p !== lead);
const month = (date: string) => new Date(date + "T12:00:00Z").toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
// The project page that tells how each one was built
const built = (slug: string) => projects.find((x) => x.writeup?.href === `/lab/${slug}`);
// Each preview comes in two widths: public/img/home/<slug>.webp (1200 px) and <slug>-640.webp
const leadBuilt = built(lead.slug);
---
<BaseLayout
  title="Lab · Alexander Kashyap"
  description="Alexander Kashyap's lab: interactive maps and charts built from public data, plus small games and experiments, all in your browser."
  path="/lab/"
  current="research"
>
<div class="gutter ed-page">
<div class="shell">
  <header class="page-head">
    <p class="kicker"><span class="k">Lab</span> <span>{posts.length} published</span></p>
    <h1 class="page-hed">Things to explore</h1>
    <p class="page-dek">Interactive maps and charts built from public data, plus small games and experiments. Everything runs right in your browser.</p>
  </header>

  <section class="h-section" aria-labelledby="lead-h">
    <div class="section-head">
      <h2 id="lead-h" class="h-label">Featured</h2>
    </div>
    <article class="feat" aria-labelledby="lead-t">
      <div class="feat-text">
        <p class="kicker"><span class="k">{lead.chips[0]}</span> <span>{month(lead.date)}</span> {lead.through && <span>Data through {lead.through}</span>}</p>
        <h3 id="lead-t" class="hed feat-hed"><a href={`/lab/${lead.slug}`}>{lead.title}</a></h3>
        <p class="h-text">{lead.lead}</p>
        <p class="stack">{lead.chips.slice(1).map((c, i) => <>{i > 0 && " "}<Tech name={c} /></>)}</p>
        <p class="feat-links">
          <a class="h-more" href={`/lab/${lead.slug}`}>{leadBuilt?.writeup?.label ?? "Read it"}</a>
          {leadBuilt && <a class="h-more" href={`/repositories/${leadBuilt.slug}`}>How it's built</a>}
        </p>
      </div>
      {lead.image && (
        <figure class="pic feat-fig">
          <img {...pics(lead.slug)} sizes="(min-width: 1024px) 742px, (min-width: 720px) calc(100vw - 64px), calc(100vw - 32px)" width="1200" height="630" decoding="async" alt={lead.image.alt}>
        </figure>
      )}
    </article>
  </section>

  {rest.length > 0 && (
    <section class="h-section" aria-labelledby="more-h">
      <div class="section-head">
        <h2 id="more-h" class="h-label">More in the lab</h2>
      </div>
      <ul class="inv-list">
        {rest.map((p) => {
          const b = built(p.slug);
          return (
            <li class="inv">
              {p.image && <div class="inv-thumb"><img {...pics(p.slug)} sizes="(min-width: 720px) 390px, calc(100vw - 32px)" width="1200" height="630" loading="lazy" decoding="async" alt={p.image.alt}></div>}
              <div>
                <p class="kicker"><span class="k">{p.chips[0]}</span> <span>{month(p.date)}</span> {p.through && <span>Data through {p.through}</span>}</p>
                <h3 class="inv-name"><a href={`/lab/${p.slug}`}>{p.title}</a></h3>
                <p class="inv-line">{p.summary}</p>
                <p class="feat-links">
                  <a class="h-more" href={`/lab/${p.slug}`}>{b?.writeup?.label ?? "Read it"}</a>
                  {b && <a class="h-more" href={`/repositories/${b.slug}`}>How it's built</a>}
                </p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</div>
</div>
</BaseLayout>

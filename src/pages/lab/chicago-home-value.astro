---
// The numbers and tables in the write-up come from the same data file the map
// loads (src/value_gap.py in the Home-Value-Score repo), filled in at build time.
import fs from "node:fs";
import path from "node:path";
import { createRequire } from "node:module";
import PostLayout from "../../layouts/PostLayout.astro";
import HomeValue from "../../components/home-value/HomeValue.svelte";
import { currentOf, factorsFor, relatedPairs, samplePerson, summarize, weightParts } from "../../components/home-value/hv.js";
import "../../styles/chicago-home-value.css";

const read = (f: string) => JSON.parse(fs.readFileSync(`public/lab/chicago-home-value${f}.json`, "utf8"));
const data = read("");
const m = data.value_model;

// The map's opening state, worked out here so the page shows it before the data loads
// and nothing jumps when it does: the sample buyer's results (the same scoring script
// the page runs), and the drive times to the sample's workplace, so the page needs the
// whole drive time grid only when a reader names another workplace.
const times = read("-drive");
const n = times.zips.length;
const cells = Buffer.from(times.minutes, "base64");
const at = new Map<string, number>(times.zips.map((z: string, i: number) => [z, i]));
const drive = (from: string, to: string) => (at.has(from) && at.has(to) ? cells[at.get(from)! * n + at.get(to)!] : null);
const workplaces = [...new Set(["buy", "rent"].map((k) => data.sample[k].workplace))] as string[];
const cols = { zips: times.zips.join(","), to: Object.fromEntries(workplaces.map((w) => [w, times.zips.map((z: string) => drive(z, w)).join(",")])) };

const HVModel = createRequire(import.meta.url)(path.resolve("public/js/chicago-home-value-model.js"));
const person = samplePerson(data, "buy");
const result = HVModel.run(data.zips, "buy", [person], data.top, drive);
const cur = currentOf(result, 0);
const rows = new Map(result.rows.map((r: any) => [r.zip, r]));
const mapped = read("-zips").features.map((f: any) => rows.get(f.id)).filter((r: any) => r && cur.ranked(r) && cur.score(r) != null).map(cur.score);
const first = {
  summary: summarize(data, result, cur, "buy", 0, [person]),
  parts: weightParts(person),
  pairs: relatedPairs(data, person, factorsFor("buy")),
  lo: Math.min(...mapped), hi: Math.max(...mapped), top: data.top,
};
const pct = (x: number) => Math.round(x * 100) + "%";
const p = (x: number) => (x < 0.001 ? "< 0.001" : x.toFixed(3));
const stat = { r2: m.r2_in_sample.toFixed(2), n: m.n, band: pct(m.in_line_band) };
const validation = Object.entries(m.validation.random_10_fold).map(([k, v]: [string, any]) => ({ name: k, random: v, spatial: m.validation.spatial_10_fold[k] }));
const coefficients = m.coefficients.filter((c: any) => c.term !== "const");

// "What I found", from the same numbers as the tables below
const coef = (term: string) => m.coefficients.find((c: any) => c.term === term);
const schools10 = (Math.exp(10 * coef("school_pct").coef) - 1) * 100;
const station = coef("log_station");
const found = [
  { n: `${m.classes.below} of ${m.n}`, text: `zips sell for more than ${stat.band} below the price per square foot their measured features predict, and ${m.classes.above} for ${stat.band} or more above it. The map’s “Price vs expected” view shows which.` },
  { n: `${schools10.toFixed(1)}% more`, text: `per square foot for every 10 percentile points of school test scores, with the model’s other factors held steady.` },
  station.p_county >= 0.05
    ? { n: "No clear effect", text: `on price per square foot from distance to a Metra, CTA or South Shore Line station, once the other factors are known (p = ${station.p_county.toFixed(2)}).` }
    : { n: `${Math.abs(station.pct_effect).toFixed(1)}% ${station.pct_effect < 0 ? "less" : "more"}`, text: `per square foot for each step further from a train station, with the other factors held steady.` },
];
---
<PostLayout slug="chicago-home-value" {found}>
  <section class="section hv-section">
    {/* The map, chart, table and form: src/components/home-value/ */}
    <HomeValue client:load {first} {cols} />

    <article class="narrow prose">
      <h2>How it works</h2>
      <ul>
        <li><b>Fit score:</b> each factor scores 100 minus the percentile gap between the zip and your target, and the fit is their weighted average.</li>
        <li><b>Price vs expected:</b> a regression on the same factors ({stat.n} zips, R² {stat.r2}) predicts each zip's price per sq ft from the other zips. Within ±{stat.band} counts as in line.</li>
      </ul>
      <div class="hv-table-wrap"><table id="hv-validation">
        <caption>Error on held-out zips (lower is better)</caption>
        <thead><tr><th>Model</th><th>Error, random</th><th>R², random</th><th>Error, by area</th><th>R², by area</th></tr></thead>
        <tbody>
          {validation.map((v) => (
            <tr class={v.name.startsWith("This model:") ? "hv-selected" : undefined}><td>{v.name}</td><td>{v.random.median_abs_pct_error.toFixed(1)}%</td><td>{v.random.r2_log.toFixed(2)}</td><td>{v.spatial.median_abs_pct_error.toFixed(1)}%</td><td>{v.spatial.r2_log.toFixed(2)}</td></tr>
          ))}
        </tbody>
      </table></div>
      <div class="hv-table-wrap"><table id="hv-coefs">
        <caption>Effect of one unit on price per sq ft</caption>
        <thead><tr><th>Factor</th><th>Effect</th><th>p</th></tr></thead>
        <tbody>
          {coefficients.map((c: any) => (
            <tr><td>{c.label}</td><td>{(c.pct_effect > 0 ? "+" : "") + c.pct_effect.toFixed(1)}%</td><td>{p(c.p_county)}</td></tr>
          ))}
        </tbody>
      </table></div>
      <p>Race and ethnicity aren't used. Full method, data and code are on <a href="https://github.com/amkashyap1220/Home-Value-Score">GitHub</a>.</p>
    </article>
  </section>

  <Fragment slot="head">
    {/* The fit score (also tested against the Python in tests/). Deferred, so it doesn't hold up
        the first paint; the map waits for it (HomeValue.svelte, by this id) */}
    <script is:inline id="hv-model" src="/js/chicago-home-value-model.js" defer></script>
  </Fragment>
</PostLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Page not found · Alexander Kashyap"
  description="This page doesn't exist."
>
  <section class="hero">
    <div class="narrow">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lead">That page doesn't exist, or it moved. Try one of these instead.</p>
      <div class="actions">
        <a class="btn primary" href="/">About me</a>
        <a class="btn" href="/projects/">Projects</a>
        <a class="btn" href="/research/">Research</a>
      </div>
    </div>
  </section>
</BaseLayout>

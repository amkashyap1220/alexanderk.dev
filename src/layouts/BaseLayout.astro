---
// The shell every page shares: <head>, site header and footer.
// A page passes its own title and description, and puts its content
// inside <BaseLayout> (it lands in <main>). Scripts that run after the
// page go in slot="scripts"; extra <head> tags go in slot="head".
// The homepage passes `home` for the full masthead; every other page gets
// the compact header (the name as the home link, then the nav). Either way
// the nav stays at the top of the screen as the page scrolls.
import { projects } from "../data/projects";
import { site } from "../data/person";
// The styles every page shares. Linked by hand, first in <head>, so every page's
// own styles come after it; Astro still minifies it and puts a hash in its name.
import siteCss from "../styles/site.css?url";

interface Props {
  title: string;              // the whole <title>, e.g. "Projects · Alexander Kashyap"
  description: string;
  path?: string;              // set on public pages: adds the link-preview tags for this URL
  ogTitle?: string;           // link preview title (defaults to title)
  ogDescription?: string;     // link preview text (defaults to description)
  ogImage?: { src: string; alt: string };   // link preview image, 1200 x 630 (defaults to /og.jpg, made by scripts/link-previews.mjs)
  noindex?: boolean;          // keep search engines off (unlock, private pages)
  current?: "about" | "projects" | "research" | "stats" | "private";   // marks the page's link in the nav or footer
  home?: boolean;             // the homepage's masthead instead of the compact header
  schema?: object;            // structured data for search engines (schema.org JSON-LD), e.g. a post's Article
}

const { title, description, path, ogTitle = title, ogDescription = description, noindex = false, current, home = false, schema } = Astro.props;
// "<" written as \u003c, so nothing in the data can close the <script> early
const schemaJson = schema && JSON.stringify({ "@context": "https://schema.org", ...schema }).replace(/</g, "\\u003c");
const ogImage = Astro.props.ogImage ?? { src: "/og.jpg", alt: "Alexander Kashyap, software developer in the Chicago area: I build software, dig into data, and share what I learn." };
const here = (tab: Props["current"]) => (current === tab ? "page" : undefined);
const email = "alexander.kashyap@gmail.com";
const year = new Date().getFullYear();
// The masthead's dateline: the month the site was built, and how many projects it has
const dateline = `${new Date().toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "America/Chicago" })} · ${projects.length} projects`;
---
<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  {path && (
    <>
      {/* The page's one address, for search engines (the same page also answers at /x.html and /x/) */}
      <link rel="canonical" href={new URL(path, site).href}>
      {/* Link previews (iMessage, Discord, Slack, LinkedIn, ...) */}
      <meta property="og:type" content="website">
      <meta property="og:site_name" content="Alexander Kashyap">
      <meta property="og:title" content={ogTitle}>
      <meta property="og:description" content={ogDescription}>
      <meta property="og:url" content={new URL(path, site).href}>
      <meta property="og:image" content={new URL(ogImage.src, site).href}>
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:image:alt" content={ogImage.alt}>
      <meta name="twitter:card" content="summary_large_image">
    </>
  )}
  {/* The site is dark only: the browser's own bars, scrollbars and form controls match */}
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0d0b09">
  {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}
  <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/newsreader-display-600.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/libre-franklin-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href={siteCss}>
  {/* Shows the Private tab (and hides the lock) once it's unlocked. It reads the
       signed_in=1 cookie the unlock code sets (worker/auth.js), which only changes
       what's shown. Inline, so it runs before the page paints, with no extra request. */}
  <script is:inline>if (/(?:^|;\s*)signed_in=1(?:;|$)/.test(document.cookie)) document.documentElement.classList.add("signed-in");</script>
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {home ? (
    <>
    <div class="masthead">
      <div class="sky">
        <div class="gutter"><div class="shell sky-inner">
          <div class="mast-top">
            <p class="ear ear-left"><span class="mono">Software developer</span> <span>Chicago area</span></p>
            <h1 class="mast-name">Alexander Kashyap</h1>
            <p class="ear ear-right"><span class="mono">Since Jan 2025</span> <span>Application Developer, <span class="nw">K-Rise Systems</span></span></p>
          </div>
          <p class="mast-tagline">I build software, dig into data, and share what I learn.</p>
        </div></div>
      </div>
    </div>
    {/* The nav row stays at the top of the screen as the page scrolls */}
    <header class="site-header masthead-bar">
      <div class="gutter"><div class="shell">
        <div class="navrow">
          <p class="dateline mono">{dateline}</p>
          <nav class="site-nav" aria-label="Main">
            <ul class="sections">
              <li><a href="/projects/" aria-current={here("projects")}>Work</a></li>
              <li><a href="/research/" aria-current={here("research")}>Research</a></li>
              <li><a href="/about" aria-current={here("about")}>About</a></li>
            </ul>
          </nav>
          <ul class="nav-actions">
            <li><a class="cta cta-solid" href="/resume.pdf">Resume <span class="mono">PDF</span></a></li>
            <li><a class="cta" href={`mailto:${email}`}>Email</a></li>
          </ul>
        </div>
      </div></div>
    </header>
    </>
  ) : (
    <header class="site-header">
      <div class="gutter"><div class="shell">
        <div class="topbar">
          <a class="brand" href="/">Alexander Kashyap</a>
          <div class="topbar-links">
            <nav class="site-nav" aria-label="Main">
              <ul class="sections">
                <li><a href="/projects/" aria-current={here("projects")}>Work</a></li>
                <li><a href="/research/" aria-current={here("research")}>Research</a></li>
                <li><a href="/about" aria-current={here("about")}>About</a></li>
              </ul>
            </nav>
            <ul class="nav-actions">
              <li><a class="cta cta-solid" href="/resume.pdf">Resume <span class="mono">PDF</span></a></li>
              <li><a class="cta" href={`mailto:${email}`}>Email</a></li>
            </ul>
          </div>
        </div>
      </div></div>
    </header>
  )}

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="gutter"><div class="shell"><div class="foot-inner">
      <div class="foot-grid">
        <div>
          <p class="foot-name">Alexander Kashyap</p>
          <p>Software developer, Chicago area.</p>
        </div>
        <nav aria-label="Footer">
          <ul>
            <li><a href="/projects/">Work</a></li>
            <li><a href="/research/">Research</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/resume.pdf">Resume</a></li>
            <li><a href={`mailto:${email}`}>Email</a></li>
          </ul>
        </nav>
        <ul aria-label="Elsewhere">
          <li><a href="https://www.linkedin.com/in/alexander-kashyap/" target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href="https://github.com/amkashyap1220" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="/stats/" aria-current={here("stats")}>GitHub Stats</a></li>
        </ul>
        <p class="colophon">Set in Newsreader, Libre Franklin and IBM Plex Mono, all open-source typefaces. Built with Astro, hosted on Cloudflare. Background: <a href="https://esahubble.org/images/heic1501a/">Pillars of Creation</a> by NASA, ESA/Hubble and the Hubble Heritage Team.</p>
      </div>
      <div class="foot-bottom">
        <p class="mono">© {year} Alexander Kashyap</p>
        <p class="foot-private">
          {/* "Private" shows once unlocked (the script in <head>); the lock hides then */}
          <a class="nav-private" href="/private/" aria-current={here("private")}>Private</a>
          <a class="icon-btn unlock-link" href="/unlock" aria-label="Unlock the private section" data-unlock>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="3" y="7" width="10" height="7" rx="1"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg>
          </a>
        </p>
      </div>
    </div></div></div>
  </footer>
  <!-- The lock icon's code box (js/unlock.js); without scripts the icon just opens /unlock -->
  <dialog class="unlock-dialog" id="unlock-dialog" aria-labelledby="unlock-dialog-h">
    <div class="unlock-top">
      <h2 class="unlock-title" id="unlock-dialog-h">Private section</h2>
      <button class="unlock-close" type="button" aria-label="Close" data-close>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M4 4l8 8M12 4l-8 8"/></svg>
      </button>
    </div>
    <p class="unlock-note">A few personal projects, behind a code.</p>
    <form class="unlock-form" method="post" action="/unlock">
      <label class="unlock-label" for="unlock-dialog-code">Code</label>
      <input id="unlock-dialog-code" name="code" type="password" inputmode="numeric" autocomplete="off" aria-describedby="unlock-dialog-error" required>
      <button class="btn primary" type="submit">Unlock</button>
      <p class="unlock-error" id="unlock-dialog-error" role="alert" hidden></p>
      <input type="hidden" name="next" value="/private/">
    </form>
  </dialog>
  {/* Hubble's Pillars of Creation behind every page (css: "4. Sky"), already dimmed. Decorative, so no alt
       text; low priority, so the styles and fonts load first. */}
  <div class="sky-bg" aria-hidden="true">
    <img src="/img/pillars-1600.webp" srcset="/img/pillars-960.webp 960w, /img/pillars-1600.webp 1600w, /img/pillars-2400.webp 2400w" sizes="(orientation: portrait) 96vh, 100vw" width="2400" height="2503" alt="" decoding="async" fetchpriority="low">
  </div>
  <script is:inline src="/js/unlock.js"></script>
  <slot name="scripts" />
</body>
</html>

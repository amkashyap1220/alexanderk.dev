---
// The shell every page shares: <head>, site header and footer.
// A page passes its own title and description, and puts its content
// inside <BaseLayout> (it lands in <main>). Scripts that run after the
// page go in slot="scripts"; extra <head> tags go in slot="head".
interface Props {
  title: string;              // the whole <title>, e.g. "Projects · Alexander Kashyap"
  description: string;
  path?: string;              // set on public pages: adds the link-preview tags for this URL
  ogTitle?: string;           // link preview title (defaults to title)
  ogDescription?: string;     // link preview text (defaults to description)
  noindex?: boolean;          // keep search engines off (login, private pages)
  current?: "about" | "projects" | "research" | "stats" | "private";   // highlighted nav tab
}

const { title, description, path, ogTitle = title, ogDescription = description, noindex = false, current } = Astro.props;
const here = (tab: Props["current"]) => (current === tab ? "page" : undefined);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  {path && (
    <>
      {/* Link previews (iMessage, Discord, Slack, LinkedIn, ...) */}
      <meta property="og:type" content="website">
      <meta property="og:site_name" content="Alexander Kashyap">
      <meta property="og:title" content={ogTitle}>
      <meta property="og:description" content={ogDescription}>
      <meta property="og:url" content={new URL(path, "https://alexanderk.dev").href}>
      <meta property="og:image" content="https://alexanderk.dev/og.png">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:image:alt" content="Alexander Kashyap, software developer: C#, .NET, SQL & Python">
      <meta name="twitter:card" content="summary_large_image">
    </>
  )}
  <meta name="theme-color" content="#eeeeec">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script is:inline src="/js/theme.js"></script>
  <script is:inline src="/js/signed-in.js"></script>
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap">
      <a class="name" href="/">Alexander Kashyap</a>
      <nav class="site-nav" aria-label="Main">
        <a href="/" aria-current={here("about")}>About</a>
        <a href="/projects/" aria-current={here("projects")}>Projects</a>
        <a href="/research/" aria-current={here("research")}>Research</a>
        <a href="/stats/" aria-current={here("stats")}><span class="nav-long">GitHub </span>Stats</a>
        <a class="nav-private" href="/private/" aria-current={here("private")}>Private</a>
      </nav>
      <div class="header-actions">
        <button class="icon-btn" type="button" data-theme-toggle aria-label="Dark mode" aria-pressed="false">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="btn small" href="https://www.linkedin.com/in/alexander-kashyap/" target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn small" href="https://github.com/amkashyap1220" target="_blank" rel="noopener">GitHub</a>
        <a class="btn small login-link" href="/login">Log in</a>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>© 2026 Alexander Kashyap</p>
      <ul class="footer-links">
        <li><a href="https://www.linkedin.com/in/alexander-kashyap/" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="https://github.com/amkashyap1220" target="_blank" rel="noopener">GitHub</a></li>
        <li class="login-link"><a href="/login">Log in</a></li>
      </ul>
    </div>
  </footer>
  <slot name="scripts" />
</body>
</html>

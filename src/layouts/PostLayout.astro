---
// A research post. The head (kicker, headline, standfirst, byline) comes from
// src/data/research.ts; the page passes its "What I found" points as `found`
// (worked out from its data when the site is built) and adds the post itself
// inside <PostLayout slug="...">. The ending links to the next investigation
// and to email. Page-only scripts go in slot="scripts" (or slot="head" for
// one that must load with the page). The layout is in src/styles/research.css.
import BaseLayout from "./BaseLayout.astro";
import { post, posts, formatDate } from "../data/research";
import { projects } from "../data/projects";
import "../styles/editorial.css";
import "../styles/research.css";

interface Props {
  slug: string;
  found?: { n: string; text: string }[];   // "What I found": a number or short phrase, then the sentence it starts
  highlight?: boolean;   // load Prism for code blocks (<pre><code class="language-...">)
}

const { slug, found = [], highlight = false } = Astro.props;
const p = post(slug);
// The project page that tells how it was built, and the next investigation (they loop)
const built = projects.find((x) => x.writeup?.href === `/research/${p.slug}`);
const next = posts.length > 1 ? posts[(posts.indexOf(p) + 1) % posts.length] : null;
---
<BaseLayout
  title={`${p.title} · Alexander Kashyap`}
  description={p.description}
  path={`/research/${p.slug}`}
  ogImage={p.image && { src: `/research/${p.slug}.png`, alt: p.image.previewAlt ?? p.image.alt }}
  current="research"
>
  <Fragment slot="head"><slot name="head" /></Fragment>
<div class="gutter ed-page">
<div class="shell">
  <article class="post" aria-labelledby="post-h">
    <header class="post-head">
      <p class="kicker"><span class="k"><a href="/research/">Research</a></span> {p.chips[0] && <span>{p.chips[0]}</span>}</p>
      <h1 id="post-h" class="page-hed">{p.title}</h1>
      <p class="page-dek">{p.lead}</p>
      <p class="byline">
        <span>By Alexander Kashyap</span>
        <span><time datetime={p.date}>{formatDate(p.date)}</time></span>
        {p.updated && <span>Updated <time datetime={p.updated}>{formatDate(p.updated)}</time></span>}
        <span>Data through {p.through}</span>
        {p.link && <a href={p.link.href}>{p.link.label}</a>}
        {built && <a href={`/projects/${built.slug}`}>How I built it</a>}
      </p>
    </header>

    {found.length > 0 && (
      <section class="found" aria-labelledby="found-h">
        <h2 id="found-h" class="h-label">What I found</h2>
        <ol>
          {found.map((f) => <li><b>{f.n}</b> <span>{f.text}</span></li>)}
        </ol>
      </section>
    )}

    <slot />

    <footer class="post-end">
      {next && (
        <div class="post-next">
          <p class="h-label">Next investigation</p>
          <p class="post-next-t"><a href={`/research/${next.slug}`}>{next.title}</a></p>
          <p class="post-next-s">{next.summary}</p>
        </div>
      )}
      <p class="post-contact">Questions about this, or data I should look at next? <a href="mailto:alexander.kashyap@gmail.com">Email me</a>.</p>
      <p><a class="h-more" href="/research/">All research</a></p>
    </footer>
  </article>
</div>
</div>

  <Fragment slot="scripts">
    <slot name="scripts" />
    {highlight && (
      <>
        {/* Code highlighting (Prism, from jsDelivr).
            The autoloader fetches each language as a page needs it. */}
        <script is:inline src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/components/prism-core.min.js"></script>
        <script is:inline src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/plugins/autoloader/prism-autoloader.min.js"></script>
      </>
    )}
  </Fragment>
</BaseLayout>

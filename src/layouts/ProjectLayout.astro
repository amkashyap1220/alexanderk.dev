---
// A project page. The header (kicker, headline, question), the facts (dates,
// status, stack, links) and the opening paragraph come from
// src/data/projects.ts; the page adds its own sections inside
// <ProjectLayout slug="...">. Sections meant to come before the rest go in
// slot="intro". The repo's README is offered last, folded, as "From the repo".
// The layout is in src/styles/work.css.
import BaseLayout from "./BaseLayout.astro";
import Readme from "../components/Readme.astro";
import { project, dates } from "../data/projects";
import "../styles/editorial.css";
import "../styles/work.css";

interface Props {
  slug: string;
  highlight?: boolean;   // load Prism for code blocks (<pre><code class="language-...">)
}

const { slug, highlight = false } = Astro.props;
const p = project(slug);
const github = `https://github.com/${p.repo}`;
---
<BaseLayout
  title={`${p.name} · Alexander Kashyap`}
  description={p.description ?? `${p.name}: ${p.summary}`}
  path={`/projects/${p.slug}`}
  ogImage={p.preview ? { src: `/projects/${p.slug}.jpg`, alt: p.preview } : undefined}
  current="projects"
>
<div class="gutter ed-page">
<div class="shell">
  <article class="cs" aria-labelledby="cs-h">
    <header class="cs-head">
      <p class="kicker"><span class="k"><a href="/projects/">Work</a></span> <span>{p.kind}</span> <span>{p.status}</span></p>
      <h1 id="cs-h" class="cs-hed">
        {p.headline ? (
          <><span class="proj">{p.name}<span class="vh">:</span></span> <span class="t">{p.headline}</span></>
        ) : p.name}
      </h1>
      <p class="cs-dek">{p.question ?? p.tagline}</p>
    </header>

    <div class="cs-grid">
      <aside class="cs-facts" aria-label="About this project">
        <dl class="spec">
          <div><dt>When</dt><dd>{dates(p.when)}</dd></div>
          <div><dt>Status</dt><dd>{p.status}</dd></div>
          <div><dt>Stack</dt><dd>{p.chips.join(", ")}</dd></div>
          <div><dt>Links</dt><dd>
            <ul class="cs-links">
              {p.writeup && <li><a href={p.writeup.href}>{p.writeup.label}</a></li>}
              {p.app && <li><a href={p.app.href}>{p.app.label}</a></li>}
              <li><a href={github}>Code on GitHub</a></li>
            </ul>
          </dd></div>
        </dl>
      </aside>

      <div class="cs-body">
        <p class="cs-lede">{p.summary}</p>
        {p.kind === "Research" && p.writeup && (
          <p class="cs-callout">This page is how I built it. The findings are in the write-up. <a class="h-more" href={p.writeup.href}>{p.writeup.label}</a></p>
        )}
        <slot name="intro" />
        <slot />
        {p.readme && <Readme repo={p.repo} />}
        <p class="cs-back"><a class="h-more" href="/projects/">All work</a></p>
      </div>
    </div>
  </article>
</div>
</div>

  <Fragment slot="scripts">
    {p.readme && <>
      <script is:inline src="/js/gh.js"></script>
      <script is:inline src="/js/github.js"></script>
    </>}
    <slot name="scripts" />
    {highlight && (
      <>
        {/* Code highlighting (Prism, from jsDelivr like the site's other libraries).
            The autoloader fetches each language as a page needs it. */}
        <script is:inline src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/components/prism-core.min.js"></script>
        <script is:inline src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/plugins/autoloader/prism-autoloader.min.js"></script>
      </>
    )}
  </Fragment>
</BaseLayout>

---
// A project's own write-up: put your HTML between <Walkthrough> and
// </Walkthrough>. A page without one just leaves it out.
interface Props { title?: string }
const { title = "How it works" } = Astro.props;
---
<section class="cs-sec" id="walkthrough" aria-labelledby="walkthrough-h">
  <h2 id="walkthrough-h" class="cs-h2">{title}</h2>
  <slot />
</section>
